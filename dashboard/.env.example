# Local-only. Never commit real secrets. Dashboard is not deployed.

#

# Public Robinhood Chain RPC for all standard eth_* / getLogs (viem/wagmi).

NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com



# Alchemy Enhanced APIs only (server-side via /api/alchemy/*).

# Never NEXT_PUBLIC_ — must not ship in the browser bundle.

# ALCHEMY_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<key>



# Optional: Blockscout API key — only for Verify-token modal explorer facts

# (holder count / source verification). Balances + Stakers PnL use Alchemy above.

# Get one at https://dev.blockscout.com

# NEXT_PUBLIC_BLOCKSCOUT_API_KEY=



# Optional: path to entropy-operator payout-ledger.csv (USD + recent rows).

# Default: ../ops/entropy-operator/payout-ledger.csv relative to dashboard cwd.

# PAYOUT_LEDGER_PATH=



# Optional: ScratchGame (v1) deploy block for legacy payout scans (default 13138508).

# GAME_DEPLOY_BLOCK=13138508



# Optional: ScratchGameV2 deploy block for payout log scans (default 18171314).

# GAME_V2_DEPLOY_BLOCK=18171314



# Optional: StakingVaultV2 deploy block for Stakers panel Deposit scans (default 18171314).

# NEXT_PUBLIC_STAKING_V2_DEPLOY_BLOCK=18171314
